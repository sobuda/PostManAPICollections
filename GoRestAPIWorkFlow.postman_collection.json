    {
      "name": "2.Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response_var = pm.response.json();\nconst res_userID = response_var.id;\nconsole.log(\"user ID: \" + res_userID);\npm.variables.set(\"userID\", res_userID);\n\npm.test(\"Successful POST request\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([201, 202]);\n});\npm.test(\"Check email prefix\", function () {\n    var jsonData = pm.response.json();\n    var expectedPrefix = \"apiautomation_\";\n    pm.expect(jsonData.email).to.have.string(expectedPrefix);\n});\n\npm.test(\"Content-Type is present\", function () {\n    pm.response.to.have.header(\"Content-Type\");\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const genders = [\"male\", \"female\"];\nconst randomGender = genders[Math.floor(Math.random() * genders.length)];\npm.collectionVariables.set(\"randomGender\", randomGender);\n\nconst status = [\"active\", \"inactive\"];\nconst randomStatus = status[Math.floor(Math.random() * status.length)];\npm.collectionVariables.set(\"randomStatus\", randomStatus);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "{{tokenID}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"{{$randomFullName}}\",\n    \"email\": \"apiautomation_{{$randomEmail}}\",\n    \"gender\": \"{{randomGender}}\",\n    \"status\": \"{{randomStatus}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/public/v2/users",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
      },
      "response": []
    },
    {
